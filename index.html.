
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BLACKNWHITE. — Back in Light</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Permanent+Marker&family=Space+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
  --black: #171717;
  --white: #fffefa;
  --pink: #ff2d91;
  --blue: #315cff;
  --purple: #9147ff;
  --yellow: #f5e936;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--white);
  color: var(--black);
  font-family: 'Space Grotesk', Arial, sans-serif;
  overflow-x: hidden;
}

a {
  color: inherit;
}

/* NAVIGATION */

header {
  position: relative;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 6%;
  border-bottom: 2px solid var(--black);
  background: var(--white);
  gap: 20px;
}

.logo {
  text-decoration: none;
  font-size: 30px;
  font-weight: 800;
  letter-spacing: -2px;
}

.logo span {
  color: var(--pink);
}

nav {
  display: flex;
  gap: 25px;
  flex-wrap: wrap;
}

nav a {
  text-decoration: none;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.5px;
  transition: color .2s;
}

nav a:hover {
  color: var(--pink);
}

/* HERO */

.hero {
  position: relative;
  min-height: 680px;
  padding: 90px 8% 100px;
  overflow: hidden;
  border-bottom: 2px solid var(--black);
  background:
    radial-gradient(circle at 85% 20%, rgba(49,92,255,.08), transparent 24%),
    radial-gradient(circle at 10% 85%, rgba(145,71,255,.07), transparent 25%),
    var(--white);
}

.hero::before {
  content: "";
  position: absolute;
  width: 330px;
  height: 180px;
  background: var(--pink);
  opacity: .12;
  filter: blur(50px);
  right: 5%;
  top: 15%;
  transform: rotate(-25deg);
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 900px;
}

.small-label {
  display: inline-block;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 4px;
  margin-bottom: 28px;
  border-bottom: 3px solid var(--pink);
  padding-bottom: 8px;
}

.hero h1 {
  font-family: 'Bebas Neue', Impact, sans-serif;
  font-size: clamp(100px, 17vw, 205px);
  line-height: .75;
  letter-spacing: -5px;
  text-transform: uppercase;
  position: relative;
  z-index: 2;
}

.hero h1 .back {
  display: block;
  color: var(--black);
  text-shadow: 4px 4px 0 var(--yellow);
}

.hero h1 .light {
  display: block;
  color: var(--pink);
  -webkit-text-stroke: 1px var(--black);
  text-shadow: 5px 5px 0 var(--black);
  transform: rotate(-2deg);
  transform-origin: left center;
  margin-top: 12px;
}

.hero-description {
  max-width: 500px;
  margin-top: 45px;
  font-size: 17px;
  line-height: 1.7;
  font-weight: 500;
}

.hero-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 30px;
}

.button {
  display: inline-block;
  padding: 15px 24px;
  text-decoration: none;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1px;
  border: 2px solid var(--black);
  transition: .2s;
}

.button.primary {
  background: var(--black);
  color: white;
  box-shadow: 5px 5px 0 var(--pink);
}

.button.secondary {
  background: var(--white);
}

.button:hover {
  transform: translate(-3px,-3px);
  box-shadow: 7px 7px 0 var(--blue);
}

/* GRAFFITI ELEMENTS */

.sticker {
  position: absolute;
  z-index: 3;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  font-family: 'Permanent Marker', cursive;
  line-height: 1.1;
  box-shadow: 5px 7px 0 rgba(0,0,0,.85);
  transition: transform .25s;
}

.sticker:hover {
  transform: rotate(0deg) scale(1.08);
}

.sticker-pink {
  background: var(--pink);
  color: white;
}

.sticker-blue {
  background: var(--blue);
  color: white;
}

.sticker-yellow {
  background: var(--yellow);
  color: var(--black);
}

.sticker-purple {
  background: var(--purple);
  color: white;
}

.sticker-a {
  width: 145px;
  height: 105px;
  right: 10%;
  top: 85px;
  transform: rotate(9deg);
  font-size: 22px;
  clip-path: polygon(8% 0,94% 7%,100% 88%,85% 100%,0 91%);
}

.sticker-b {
  width: 125px;
  height: 115px;
  right: 25%;
  bottom: 65px;
  transform: rotate(-12deg);
  font-size: 19px;
  border-radius: 50%;
}

.sticker-c {
  width: 130px;
  height: 85px;
  right: 6%;
  bottom: 110px;
  transform: rotate(7deg);
  font-size: 17px;
}

.spray-mark {
  position: absolute;
  right: 12%;
  top: 40%;
  font-family: 'Permanent Marker', cursive;
  color: var(--blue);
  font-size: 65px;
  transform: rotate(-18deg);
  opacity: .9;
  text-shadow: 2px 2px 0 var(--yellow);
}

.paint-splash {
  position: absolute;
  border-radius: 50%;
  filter: blur(1px);
  opacity: .8;
  pointer-events: none;
}

.splash-one {
  width: 18px;
  height: 18px;
  background: var(--purple);
  right: 42%;
  top: 13%;
  box-shadow: 30px 25px 0 var(--purple),
              60px -5px 0 var(--purple),
              45px 65px 0 var(--purple);
}

.splash-two {
  width: 12px;
  height: 12px;
  background: var(--pink);
  left: 5%;
  bottom: 15%;
  box-shadow: 30px 20px 0 var(--pink),
              55px -10px 0 var(--pink),
              80px 35px 0 var(--pink);
}

/* MOVING MESSAGE */

.ticker {
  background: var(--black);
  color: white;
  padding: 15px 0;
  overflow: hidden;
  white-space: nowrap;
  border-bottom: 4px solid var(--yellow);
}

.ticker-track {
  display: inline-block;
  font-family: 'Bebas Neue', sans-serif;
  font-size: 27px;
  letter-spacing: 3px;
  animation: move 25s linear infinite;
}

.ticker-track span {
  color: var(--pink);
  margin: 0 25px;
}

@keyframes move {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

/* INTRO */

.intro {
  padding: 110px 9%;
  position: relative;
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 70px;
  align-items: center;
}

.section-label {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 4px;
  color: var(--blue);
  margin-bottom: 22px;
}

.intro h2 {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(60px, 8vw, 100px);
  line-height: .88;
  letter-spacing: -2px;
}

.intro h2 span {
  color: var(--pink);
  -webkit-text-stroke: 1px var(--black);
}

.intro-copy {
  font-size: 17px;
  line-height: 1.9;
}

.intro-copy strong {
  background: var(--yellow);
  padding: 2px 5px;
}

/* STICKER QUOTE */

.quote-section {
  padding: 85px 9%;
  background: #f0edff;
  border-top: 2px solid var(--black);
  border-bottom: 2px solid var(--black);
  position: relative;
  overflow: hidden;
}

.quote-section h2 {
  font-family: 'Permanent Marker', cursive;
  font-size: clamp(35px, 6vw, 70px);
  line-height: 1.15;
  max-width: 850px;
  transform: rotate(-2deg);
  position: relative;
  z-index: 2;
}

.quote-section h2 span {
  color: var(--pink);
  text-shadow: 3px 3px 0 var(--black);
}

.quote-tag {
  display: inline-block;
  background: var(--yellow);
  padding: 12px 20px;
  margin-top: 30px;
  font-weight: 900;
  transform: rotate(3deg);
  box-shadow: 4px 4px 0 var(--black);
}

/* EXPLORE */

.explore {
  padding: 100px 8%;
}

.explore-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 25px;
  margin-bottom: 50px;
  flex-wrap: wrap;
}

.explore-heading h2 {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(60px, 9vw, 105px);
  line-height: .9;
}

.explore-heading p {
  max-width: 300px;
  font-size: 14px;
  line-height: 1.7;
}

.page-links {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}

.page-card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 310px;
  padding: 28px;
  text-decoration: none;
  border: 2px solid var(--black);
  box-shadow: 7px 7px 0 var(--black);
  transition: .2s;
  position: relative;
  overflow: hidden;
}

.page-card:hover {
  transform: translate(-4px,-4px);
  box-shadow: 11px 11px 0 var(--black);
}

.page-card:nth-child(1) {
  background: var(--yellow);
}

.page-card:nth-child(2) {
  background: var(--blue);
  color: white;
}

.page-card:nth-child(3) {
  background: var(--pink);
  color: white;
}

.card-number {
  font-size: 13px;
  font-weight: 900;
  letter-spacing: 2px;
}

.page-card h3 {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 48px;
  line-height: .95;
}

.card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 1px;
}

.card-arrow {
  font-size: 28px;
}

/* FINAL MESSAGE */

.final-message {
  position: relative;
  padding: 100px 9%;
  background: var(--black);
  color: white;
  overflow: hidden;
}

.final-message h2 {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(70px, 12vw, 140px);
  line-height: .85;
  max-width: 900px;
}

.final-message h2 span {
  color: var(--yellow);
}

.final-message p {
  max-width: 540px;
  margin-top: 30px;
  line-height: 1.8;
  font-size: 16px;
}

.final-sticker {
  position: absolute;
  right: 12%;
  bottom: 55px;
  background: var(--pink);
  color: white;
  font-family: 'Permanent Marker', cursive;
  padding: 24px;
  transform: rotate(10deg);
  font-size: 22px;
  box-shadow: 6px 6px 0 var(--white);
}

/* FOOTER */

footer {
  padding: 30px 7%;
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.5px;
  border-top: 2px solid var(--white);
}

footer span {
  color: var(--pink);
}

/* RESPONSIVE */

@media(max-width: 850px) {
  .sticker-a { right: 5%; }
  .sticker-b { right: 12%; }
  .sticker-c { right: 4%; }
  .intro {
    grid-template-columns: 1fr;
    gap: 35px;
  }
  .page-links {
    grid-template-columns: 1fr;
  }
  .page-card {
    min-height: 230px;
  }
}

@media(max-width: 600px) {
  header {
    align-items: flex-start;
    flex-direction: column;
  }

  nav {
    gap: 13px;
  }

  .hero {
    padding: 75px 7%;
    min-height: 650px;
  }

  .hero h1 {
    font-size: clamp(90px, 19vw, 130px);
  }

  .hero-description {
    font-size: 15px;
  }

  .sticker-a {
    top: auto;
    bottom: 170px;
    right: 7%;
    width: 110px;
    height: 80px;
    font-size: 16px;
  }

  .sticker-b {
    bottom: 55px;
    right: 42%;
    width: 90px;
    height: 90px;
    font-size: 15px;
  }

  .sticker-c {
    bottom: 70px;
    right: 5%;
    width: 100px;
    height: 70px;
    font-size: 13px;
  }

  .spray-mark {
    top: 47%;
    right: 5%;
    font-size: 40px;
  }

  .intro,
  .explore,
  .quote-section,
  .final-message {
    padding: 70px 7%;
  }

  .final-sticker {
    position: relative;
    display: inline-block;
    right: auto;
    bottom: auto;
    margin-top: 40px;
  }

  footer {
    padding: 25px 7%;
  }
}

@media(prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .ticker-track { animation: none; }
  * { transition: none !important; }
}
</style>
</head>

